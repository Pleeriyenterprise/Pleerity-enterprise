# Zoho Integration — environment configuration (all default disabled)
# Copy relevant keys to Render/staging secrets. NEVER enable production sync without governance sign-off.

ZOHO_INTEGRATION_ENABLED=false
ZOHO_KILL_SWITCH=false

# Per-integration flags (require ZOHO_INTEGRATION_ENABLED=true)
ZOHO_ANALYTICS_SYNC_ENABLED=false
ZOHO_CRM_SYNC_ENABLED=false
ZOHO_CAMPAIGNS_SYNC_ENABLED=false
ZOHO_CAMPAIGNS_KIT_GAP_CONFIRMED=false
ZOHO_SIGN_SYNC_ENABLED=false
ZOHO_BOOKS_SYNC_ENABLED=false
ZOHO_WORKDRIVE_SYNC_ENABLED=false

# Environment isolation
ZOHO_ENVIRONMENT=staging
ZOHO_API_BASE=https://www.zohoapis.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu

# OAuth (staging org only until production approval)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Per-integration refresh tokens (Option B — one token per Zoho business application)
ZOHO_ANALYTICS_REFRESH_TOKEN=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CAMPAIGNS_REFRESH_TOKEN=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_WORKDRIVE_REFRESH_TOKEN=

# Deprecated — migration fallback only; remove before production rollout (see OAUTH_DEPRECATION_POLICY.md)
ZOHO_REFRESH_TOKEN=

ZOHO_ORG_ID=

# Webhook secrets (per integration)
ZOHO_WEBHOOK_SECRET=
ZOHO_SIGN_WEBHOOK_SECRET=
ZOHO_CAMPAIGNS_WEBHOOK_SECRET=
ZOHO_CRM_WEBHOOK_SECRET=
ZOHO_BOOKS_WEBHOOK_SECRET=

# Optional targets
ZOHO_ANALYTICS_WORKSPACE_ID=
ZOHO_WORKDRIVE_INTERNAL_FOLDER_ID=
ZOHO_CRM_MODULE=Leads
