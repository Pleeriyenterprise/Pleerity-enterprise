{
  "tenant_safe_routes": [
    "GET /api/tenant/dashboard",
    "GET /api/tenant/property/{property_id}",
    "POST /api/tenant/report-issue",
    "POST /api/tenant/report-maintenance",
    "POST /api/tenant/contact-landlord",
    "GET /api/tenant/requests",
    "GET /api/tenant/reported-issues"
  ],
  "preserved": true,
  "lifecycle_visibility": {
    "endpoint": "GET /api/tenant/reported-issues",
    "phases": ["reported", "acknowledged", "in_progress", "completed"],
    "scope": "tenant-reported issues only (source tenant_request/tenant, reporter_contact match, assigned properties)"
  }
}
